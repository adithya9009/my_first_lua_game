local SPEED = 100

-- Screen boundaries (adjust to your game.project display resolution)
local MIN_X, MAX_X = 16, 944
local MIN_Y, MAX_Y = 16, 624

function init(self)
	msg.post(".", "acquire_input_focus")
	self.dir = vmath.vector3()
	self.facing = "front"
	self.current_anim = ""
	self.is_moving = false

	-- Persistent state tracking for input keys
	self.keys = {
		up = false,
		down = false,
		left = false,
		right = false
	}
end

local function set_facing(self, anim_name)
	self.facing = anim_name

	-- Only restart flipbook if the directional animation actually changed
	if self.current_anim ~= anim_name then
		self.current_anim = anim_name
		sprite.play_flipbook("#body", hash(anim_name))
		sprite.play_flipbook("#head", hash(anim_name))
	end
end

function update(self, dt)
	-- Recompute direction vector from key states every frame
	self.dir.x = 0
	self.dir.y = 0

	if self.keys.up then self.dir.y = self.dir.y + 1 end
	if self.keys.down then self.dir.y = self.dir.y - 1 end
	if self.keys.left then self.dir.x = self.dir.x - 1 end
	if self.keys.right then self.dir.x = self.dir.x + 1 end

	local moving = vmath.length_sqr(self.dir) > 0

	if moving then
		if not self.is_moving then
			self.is_moving = true
			go.set("#body", "playback_rate", 1)
			go.set("#head", "playback_rate", 1)
		end

		-- Normalize diagonal vector to prevent 1.41x speed scaling
		self.dir = vmath.normalize(self.dir)

		-- Update character direction facing
		if self.dir.y > 0 then
			set_facing(self, "back")
		elseif self.dir.y < 0 then
			set_facing(self, "front")
		elseif self.dir.x < 0 then
			set_facing(self, "left")
		elseif self.dir.x > 0 then
			set_facing(self, "right")
		end

		local pos = go.get_position()
		pos = pos + self.dir * SPEED * dt

		-- Sub-pixel rounding
		pos.x = math.floor(pos.x + 0.5)
		pos.y = math.floor(pos.y + 0.5)

		-- Screen boundary clamping
		pos.x = math.max(MIN_X, math.min(MAX_X, pos.x))
		pos.y = math.max(MIN_Y, math.min(MAX_Y, pos.y))

		go.set_position(pos)
	else
		if self.is_moving then
			self.is_moving = false
			-- Freeze playback on current frame when movement stops
			go.set("#body", "playback_rate", 0)
			go.set("#head", "playback_rate", 0)
			go.set("#body", "cursor", 0)
			go.set("#head", "cursor", 0)
		end
	end
end

function on_input(self, action_id, action)
	-- Track press and release state cleanly
	local is_pressed = not action.released

	if action_id == hash("up") then
		self.keys.up = is_pressed
	elseif action_id == hash("down") then
		self.keys.down = is_pressed
	elseif action_id == hash("left") then
		self.keys.left = is_pressed
	elseif action_id == hash("right") then
		self.keys.right = is_pressed
	end
end